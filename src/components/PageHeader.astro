---
import Icon from './Icon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="page-header">
  <a class="back-btn" href="/" aria-label="Kembali ke beranda Meowville">
    <Icon name="arrow_back" size={20} />
  </a>
  <p class="page-header__title">{title}</p>
</header>
