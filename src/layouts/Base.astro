---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description, noindex = false, bodyClass = '' } = Astro.props;
const developerName = 'Najer.dev';
const cleanPath =
  Astro.url.pathname
    .replace(/\/index\.html$/, '/')
    .replace(/\.html$/, '')
    .replace(/\/+$/, '') || '/';
const canonicalUrl = new URL(cleanPath, Astro.site);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FAF8F4" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body class={bodyClass || undefined}>
    <a class="skip-link" href="#main-content">Langsung ke isi utama</a>
    <div id="top" class="page-shell">
      <main id="main-content" class="container">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="container footer-inner">
          <nav class="footer-links" aria-label="Tautan legal dan kontak">
            <a href="/privacy">Privasi</a>
            <span class="footer-sep" aria-hidden="true">&middot;</span>
            <a href="/terms">Ketentuan</a>
            <span class="footer-sep" aria-hidden="true">&middot;</span>
            <a href="/hapus-akun">Hapus akun</a>
            <span class="footer-sep footer-sep--email" aria-hidden="true">&middot;</span>
            <a class="footer-email" href="mailto:meowville@najer.dev">meowville@najer.dev</a>
          </nav>
          <p class="footer-copy">&copy; 2026 {developerName}</p>
        </div>
      </footer>
    </div>
  </body>
</html>
