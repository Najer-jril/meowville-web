---
import { getEntry, render } from 'astro:content';
import LegalPage from '../layouts/LegalPage.astro';

const entry = await getEntry('legal', 'terms');
if (!entry) {
  throw new Error('Missing src/content/terms.md');
}
const { Content, headings } = await render(entry);
const sectionHeadings = headings.filter((h) => h.depth === 2);
---

<LegalPage {...entry.data} headings={sectionHeadings}>
  <Content />
</LegalPage>
